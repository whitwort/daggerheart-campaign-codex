# clasp credentials - contains OAuth tokens, must never be committed
.clasprc.json
*.clasprc.json

# Firebase service account key - contains private key, must never be committed
scripts/service-account.json
scripts/*.json
scripts/*-key.json

# Firestore backups - campaign data, must never land in this public repo.
# Backups live in the private whitwort/aethers-children-data repo instead
# (see .github/workflows/backup.yml). This is a guard against accidental
# local drops, not the enforcement mechanism.
backups/
backup-repo/

# Node
node_modules/

# OS/editor cruft
.DS_Store
*.swp
*~
__pycache__/

# Firestore emulator debug logs (test:rules)
firestore-debug.log
ui-debug.log

# Firebase/Auth emulator debug logs + seed handoff (test:e2e)
firebase-debug.log
auth-debug.log
hosting-debug.log
tests/e2e/.seed.json

# Playwright
/test-results/
/playwright-report/
