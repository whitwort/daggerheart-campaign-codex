rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isGM() {
      return request.auth != null
        && request.auth.token.email == 'whitwort@gmail.com'; // keep in sync with Config.gs gmEmail
    }

    // Phase 7a: authenticated + on the players whitelist.
    function isPlayer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/players/$(request.auth.token.email));
    }

    // Deploy metadata (_meta/version: deployed commit hash, written by CI
    // via the Admin SDK, which bypasses rules — hence no client write path).
    // Read for ANY signed-in user (not just GM/player) so even a not-yet-
    // whitelisted session can detect updates. Nothing sensitive in it.
    match /_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Phase 0 smoke-test doc only.
    match /_health/{docId} {
      allow read: if true;
      allow write: if isGM();
    }

    // Entries: content_gm vs content_player is still a client render choice
    // (not a security boundary) for content readable at all. Auth-model
    // overhaul (Aug 2026): no unauthenticated access at all — every user is
    // either GM or a whitelisted Player. `public` flag from the earlier
    // Phase 7a design is dropped; Phase 7a-1 supersedes it.
    match /entries/{entryId} {
      allow read: if isGM() || isPlayer();
      allow write: if isGM();
    }

    // GM's player whitelist. Any signed-in user can read their OWN doc (to
    // resolve their own role, including the not-yet-whitelisted case for
    // the join-request flow); only GM can read the whole collection's other
    // docs or write.
    match /players/{email} {
      allow read: if isGM() || (request.auth != null && request.auth.token.email == email);
      allow write: if isGM();
    }

    // Map pins: {entryId, x, y} linking a point on the base map image to a
    // Codex entry. Same GM/Player-only read model as entries.
    match /pins/{pinId} {
      allow read: if isGM() || isPlayer();
      allow write: if isGM();
    }

    // Maps: {name, image, parentMapId}. Root map has parentMapId == null.
    // `public` flag dropped, same as entries — see note above.
    match /maps/{mapId} {
      allow read: if isGM() || isPlayer();
      allow write: if isGM();
    }

    // Images (Phase 7b): {ownerType, ownerId, role, data, contentType,
    // width, height, sizeBytes, uploadedAt}. Same GM/Player-only read
    // model as entries/maps/pins — no separate public/private concept.
    match /images/{imageId} {
      allow read: if isGM() || isPlayer();
      allow write: if isGM();
    }

    // Campaign-wide config (Phase 7b): currently just { rootMapId }, GM-
    // selected via the Admin tab. Replaces the old parentMapId==null
    // structural-root convention.
    match /config/{docId} {
      allow read: if isGM() || isPlayer();
      allow write: if isGM();
    }

    // Join requests (Phase 7a-4): a signed-in-but-unlisted user files a
    // request at their own email-keyed doc; GM reviews and either adds them
    // to `players` (accept) or deletes the request (reject). A user can
    // only create/read/delete their OWN request doc (delete lets them
    // cancel/retry); only GM can read the full collection or update it.
    match /joinRequests/{email} {
      allow create: if request.auth != null && request.auth.token.email == email;
      allow read: if isGM() || (request.auth != null && request.auth.token.email == email);
      allow delete: if isGM() || (request.auth != null && request.auth.token.email == email);
      allow update: if isGM();
    }

    // --- Phase 8 collections ---------------------------------------------
    // Security model (locked): write-integrity only. Reads for every
    // collection are just isGM() || isPlayer(); GM-only vs player-visible
    // content is a CLIENT RENDER choice, not a rules boundary. A whitelisted
    // player with a hacked client can read gm-only lore — accepted
    // (trust-the-table model, see phase 8 handoff).

    // Sources (interjected before Phase 13): GM-maintained attribution
    // list, {text: markdown, createdAt, updatedAt}. Entities/loreItems
    // carry an optional sourceId pointing here (images too, but images
    // has no shape-validation function to extend — see match /images/
    // above). Read for GM+player: attribution is always shown to players,
    // not just GM bookkeeping (Gregg's call). Write GM-only.
    function isValidSource() {
      return request.resource.data.keys().hasOnly(['text', 'order', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0;
    }
    match /sources/{sourceId} {
      allow read: if isGM() || isPlayer();
      allow create, update: if isGM() && isValidSource();
      allow delete: if isGM();
    }

    // Entities: unified lore/location objects. Replaces `entries`.
    // {slug, name, category, parentId, relatedIds, visibility,
    //  hasMapImage, tags, createdAt, updatedAt}
    // 'mapId' is a dead legacy field still present on early test docs;
    // tolerated in hasOnly so updates to those docs don't fail.
    // 'subtype' (Phase 12b, SRD import): optional finer-grained label
    // under a Game Mechanics/Equipment category (e.g. subtype 'weapons'
    // under category 'Equipment'). Not category-exclusive like ancestry.
    // 'useTemplate' (structured stat-block pilot): opt-in per entity, GM-
    // set. 'details' ({key: value} strings) and 'features' ({name,text}[])
    // are the structured data it renders from -- see templates.js for the
    // per-(category,subtype) whitelist that governs which scalar fields
    // are allowed to live here vs. staying long-tail markdown.
    // 'meta' on entities is dead legacy (removed -- Meta badge is now
    // derived from category membership in CONFIG.metaCategories, not a
    // per-entity flag). Tolerated in hasOnly, same as 'mapId' above, so
    // updates to already-written docs don't fail.
    function isValidEntity() {
      return request.resource.data.keys().hasOnly(
          ['slug', 'name', 'category', 'subtype', 'parentId', 'relatedIds', 'mapId',
           'hasMapImage', 'visibility', 'tags', 'createdAt', 'updatedAt',
           'ancestry', 'aliases', 'date', 'dateSort', 'ownerId', 'sourceId', 'meta',
           'useTemplate', 'details', 'features'])
        && request.resource.data.visibility in ['gm-only', 'all-players']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.slug is string
        && request.resource.data.category is string;
    }
    match /entities/{entityId} {
      allow read: if isGM() || isPlayer();
      allow create, update: if isGM() && isValidEntity();
      allow delete: if isGM();
    }

    // Lore items: per-entity content blocks with individual visibility.
    // Replaces entries.content_gm/content_player. First collection with a
    // non-GM write path (player notes) — hence the tighter shape checks.
    // {entityId, kind, authorId, authorType, visibility, content, order,
    //  createdAt, updatedAt}
    // 'meta': enum, null/absent = none, 'meta' = general GM/mechanics
    // marker, 'meta-details'/'meta-features' = structured-template pilot
    // anchor items (codex.js display-time-merges entity.details/features
    // into the first such item -- see resolveLoreItemMarkdown). Legacy
    // boolean true/false from before the enum is still tolerated (not
    // rewritten retroactively).
    function isValidLoreItem() {
      return request.resource.data.keys().hasOnly(
          ['entityId', 'kind', 'authorId', 'authorType', 'visibility',
           'content', 'meta', 'sourceId', 'order', 'createdAt', 'updatedAt'])
        && request.resource.data.entityId is string
        && request.resource.data.kind in ['imported', 'gm-note', 'player-note']
        && request.resource.data.visibility in ['gm-only', 'all-players', 'author-only']
        && request.resource.data.content is string
        && (!('meta' in request.resource.data)
            || request.resource.data.meta == null
            || request.resource.data.meta is bool
            || request.resource.data.meta in ['meta', 'meta-details', 'meta-features']);
    }
    // Player-note constraint: players may only write their OWN notes, and
    // can't disguise a note as another kind or another author. GM writes
    // anything shape-valid.
    function isOwnPlayerNoteWrite() {
      return request.resource.data.kind == 'player-note'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorType == 'player'
        && request.resource.data.visibility in ['author-only', 'all-players'];
    }
    match /loreItems/{itemId} {
      allow read: if isGM() || isPlayer();
      allow create: if isValidLoreItem()
        && (isGM() || (isPlayer() && isOwnPlayerNoteWrite()));
      allow update: if isValidLoreItem()
        && (isGM() || (isPlayer()
              && resource.data.kind == 'player-note'
              && resource.data.authorId == request.auth.uid
              && isOwnPlayerNoteWrite()));
      allow delete: if isGM()
        || (isPlayer()
              && resource.data.kind == 'player-note'
              && resource.data.authorId == request.auth.uid);
    }

    // Deploy metadata (_meta/version): {hash, deployedAt}, written by CI
    // via the Admin SDK (bypasses rules — no client write path at all).
    // Any signed-in user may read; no sensitive data.
    match /_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
