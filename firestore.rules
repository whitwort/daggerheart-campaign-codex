rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isGM() {
      return request.auth != null
        && request.auth.token.email == 'whitwort@gmail.com'; // keep in sync with config.js gmEmail
    }

    // Phase 7a: authenticated + on the players whitelist.
    function isPlayer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/players/$(request.auth.token.email));
    }

    // Phase 14 S1: the core new helper. A player has full authority over
    // any Character entity they own (D4/§6.2) -- every player write path
    // below routes through this. Costs 1 get() per call; a single write
    // may evaluate it more than once across multiple `allow` clauses (each
    // clause is tried independently) -- fine at table scale, well under
    // Firestore's per-request read-call ceiling (phase-14-design.md §7).
    function ownsCharacter(charId) {
      let c = get(/databases/$(database)/documents/entities/$(charId)).data;
      return c.category == 'Character' && c.ownerId == request.auth.token.email;
    }

    // Deploy metadata (_meta/version: deployed commit hash + semantic
    // version, written by CI via the Admin SDK, which bypasses rules —
    // hence no client write path).
    // Read for ANY signed-in user (not just GM/player) so even a not-yet-
    // whitelisted session can detect updates. Nothing sensitive in it.
    match /_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // GM's player whitelist. Any signed-in user can read their OWN doc (to
    // resolve their own role, including the not-yet-whitelisted case for
    // the join-request flow); only GM can read the whole collection's other
    // docs or write, EXCEPT a player may update their own `activeCharacterId`
    // (Phase 14 S1/§3.4 -- the nav dropdown / Characters tab's set-active
    // control, S3) -- restricted to that one field via affectedKeys.
    match /players/{email} {
      allow read: if isGM() || (request.auth != null && request.auth.token.email == email);
      allow create, delete: if isGM();
      allow update: if isGM() || (
        request.auth != null && request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeCharacterId'])
      );
    }

    // Map pins: {entryId, x, y} linking a point on the base map image to a
    // Codex entry. Same GM/Player-only read model as entries.
    match /pins/{pinId} {
      allow read: if isGM() || isPlayer();
      allow write: if isGM();
    }

    // Encounters (Phase 15): GM-only builder/tracker docs. No player
    // surface in v1 (E2) -- does not touch the deferred player-write
    // rules matrix.
    match /encounters/{encId} {
      allow read, write: if isGM();
    }

    // Lore Drops (Phase 17): GM-only batched visibility-change docs
    // ({name, status, changes[], createdAt, ranAt}). Recorded in the
    // Codex, run/undone from the Stables tab. Same GM-only stance as
    // encounters -- players only ever see the RESULTING visibility
    // changes (written to entities/loreItems/images under the existing
    // rules above) plus the consolidated 'lore-drop' notification.
    match /loreDrops/{dropId} {
      allow read, write: if isGM();
    }

    // Images: {ownerType, ownerId, role, visibility, characterId,
    // characterShared, sourceId, data, contentType, width, height,
    // sizeBytes, uploadedAt, isPortrait, isMap, sortOrder, portraitZoomStep,
    // portraitOffsetXFrac, portraitOffsetYFrac, portraitFadeH,
    // portraitFadeV}. Phase 14 S1: first real shape validation on this
    // collection (previously GM-write-only with no isValidImage() at all --
    // see phase-14-design.md §3.3, flagged as required before any player
    // write path could open here). visibility triple mirrors entities/
    // loreItems minus 'author-only' (images are never notes).
    function isValidImage() {
      return request.resource.data.keys().hasOnly(
          ['ownerType', 'ownerId', 'role', 'visibility', 'characterId', 'characterShared', 'sourceId',
           'data', 'contentType', 'width', 'height', 'sizeBytes', 'uploadedAt',
           'isPortrait', 'isMap', 'sortOrder',
           'portraitZoomStep', 'portraitOffsetXFrac', 'portraitOffsetYFrac', 'portraitFadeH', 'portraitFadeV'])
        && request.resource.data.ownerType is string
        && request.resource.data.ownerId is string
        && request.resource.data.role is string
        && request.resource.data.visibility in ['gm-only', 'all-players', 'character'];
    }
    match /images/{imageId} {
      allow read: if isGM() || isPlayer();

      allow create: if isGM() && isValidImage();
      allow create: if isPlayer() && isValidImage()
        && request.resource.data.ownerType == 'entity' && ownsCharacter(request.resource.data.ownerId);

      allow update: if isGM() && isValidImage();
      // Full CRUD under an owned Character (gallery images the player
      // uploaded for their own PC).
      allow update: if isPlayer() && isValidImage()
        && resource.data.ownerType == 'entity' && ownsCharacter(resource.data.ownerId);
      // Content/sourceId/characterShared edit on an image the GM shared
      // with the player's active character (§6.2) -- no delete, no
      // touching role/isMap/isPortrait/ownerId/visibility/characterId.
      allow update: if isPlayer()
        && resource.data.visibility == 'character' && ownsCharacter(resource.data.characterId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['data', 'contentType', 'width', 'height', 'sizeBytes', 'sourceId', 'characterShared']);

      allow delete: if isGM()
        || (isPlayer() && resource.data.ownerType == 'entity' && ownsCharacter(resource.data.ownerId));
    }

    // Campaign-wide config (Phase 7b): currently just { rootMapId }, GM-
    // selected via the Admin tab. Replaces the old parentMapId==null
    // structural-root convention.
    match /config/{docId} {
      allow read: if isGM() || isPlayer();
      allow write: if isGM();
    }

    // Join requests (Phase 7a-4): a signed-in-but-unlisted user files a
    // request at their own email-keyed doc; GM reviews and either adds them
    // to `players` (accept) or deletes the request (reject). A user can
    // only create/read/delete their OWN request doc (delete lets them
    // cancel/retry); only GM can read the full collection or update it.
    match /joinRequests/{email} {
      allow create: if request.auth != null && request.auth.token.email == email;
      allow read: if isGM() || (request.auth != null && request.auth.token.email == email);
      allow delete: if isGM() || (request.auth != null && request.auth.token.email == email);
      allow update: if isGM();
    }

    // Character transfer requests (Phase 14 §3.5/§8 D8): a player asks to
    // take over an unowned PC. Auto-ID docs (unlike joinRequests' email-
    // keyed singleton) since a player may file more than one over a
    // campaign's life. {characterId, toEmail, requestedAt}. GM approves
    // (sets the character's ownerId elsewhere, then deletes this doc) or
    // rejects (deletes). The GM Requests queue (D8, S5) consolidates this
    // with joinRequests client-side -- these stay separate collections.
    function isValidTransferRequest() {
      return request.resource.data.keys().hasOnly(['characterId', 'toEmail', 'requestedAt'])
        && request.resource.data.characterId is string
        && request.resource.data.toEmail is string;
    }
    match /transferRequests/{reqId} {
      allow read: if isGM() || (request.auth != null && resource.data.toEmail == request.auth.token.email);
      allow create: if isPlayer() && isValidTransferRequest()
        && request.resource.data.toEmail == request.auth.token.email;
      allow delete: if isGM() || (request.auth != null && resource.data.toEmail == request.auth.token.email);
      allow update: if isGM();
    }

    // GM<->player messaging (Phase 14 §3.5/§6.6, S6). One thread doc per
    // player, keyed by email (mirrors players/{email}'s own keying).
    // {lastMessageAt, lastMessagePreview, gmLastReadAt, playerLastReadAt}.
    // Messages are a subcollection -- the FIRST subcollection in this app
    // (listeners.js gets per-thread dynamic listeners, S6). Messages are
    // immutable once sent (no update/delete at all, GM included) -- a
    // chat log shouldn't be editable after the fact.
    function isValidThread() {
      return request.resource.data.keys().hasOnly(['lastMessageAt', 'lastMessagePreview', 'gmLastReadAt', 'playerLastReadAt']);
    }
    function isValidMessage() {
      return request.resource.data.keys().hasOnly(['authorRole', 'text', 'createdAt'])
        && request.resource.data.authorRole in ['gm', 'player']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0;
    }
    match /threads/{playerEmail} {
      allow read: if isGM() || (request.auth != null && request.auth.token.email == playerEmail);
      allow create: if isValidThread()
        && (isGM() || (request.auth != null && request.auth.token.email == playerEmail));
      allow update: if isValidThread() && (
        isGM() ||
        (request.auth != null && request.auth.token.email == playerEmail &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['playerLastReadAt', 'lastMessageAt', 'lastMessagePreview']))
      );
      allow delete: if isGM();

      match /messages/{msgId} {
        allow read: if isGM() || (request.auth != null && request.auth.token.email == playerEmail);
        allow create: if isValidMessage() && (
          (isGM() && request.resource.data.authorRole == 'gm') ||
          (request.auth != null && request.auth.token.email == playerEmail && request.resource.data.authorRole == 'player')
        );
        allow update, delete: if false;
      }
    }

    // Unlock notifications (Phase 14 §3.5/§6.7, S6). Written at share-time
    // (sharing.js), never diff-detected -- both GM and player clients can
    // create these (trust-the-table model, same as every other collection
    // here), shape-validated. Recipient may only flip their own `seenAt`.
    // Phase 17 B4: kind 'lore-drop' -- ONE consolidated doc per newly-
    // exposed player when the GM runs a Lore Drop (stables.js), carrying
    // dropName + the entityIds list instead of a single entityId.
    function isValidNotification() {
      return request.resource.data.keys().hasOnly(
          ['recipientEmail', 'kind', 'entityId', 'loreItemId', 'actorCharacterId', 'createdAt', 'seenAt', 'requestEmail', 'provider',
           'dropName', 'entityIds'])
        && request.resource.data.recipientEmail is string
        && request.resource.data.kind in ['discovered', 'learned', 'shared', 'joinRequest', 'lore-drop']
        && (request.resource.data.kind != 'joinRequest' || request.resource.data.requestEmail is string)
        && (request.resource.data.kind != 'lore-drop' ||
            (request.resource.data.dropName is string && request.resource.data.entityIds is list))
        && (request.resource.data.kind in ['joinRequest', 'lore-drop'] || request.resource.data.entityId is string);
    }
    match /notifications/{notifId} {
      allow read: if isGM() || (request.auth != null && resource.data.recipientEmail == request.auth.token.email);
      allow create: if isValidNotification() && (
        (isGM() || isPlayer()) ||
        (request.auth != null && request.resource.data.kind == 'joinRequest')
      );
      allow update: if request.auth != null && resource.data.recipientEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']);
      allow delete: if isGM();
    }

    // --- Phase 8 collections ---------------------------------------------
    // Security model (locked): write-integrity only. Reads for every
    // collection are just isGM() || isPlayer(); GM-only vs player-visible
    // content is a CLIENT RENDER choice, not a rules boundary. A whitelisted
    // player with a hacked client can read gm-only lore — accepted
    // (trust-the-table model, see phase 8 handoff). Phase 14 (S1): real
    // player WRITE paths land for the first time on entities/loreItems/
    // images (owned-Character authority, D4) -- the read model above is
    // otherwise unchanged.

    // Sources (interjected before Phase 13): GM-maintained attribution
    // list, {text: markdown, createdAt, updatedAt}. Entities/loreItems/
    // images carry an optional sourceId pointing here. Read for GM+player:
    // attribution is always shown to players, not just GM bookkeeping
    // (Gregg's call). Write GM-only.
    function isValidSource() {
      return request.resource.data.keys().hasOnly(['text', 'order', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0;
    }
    match /sources/{sourceId} {
      allow read: if isGM() || isPlayer();
      allow create, update: if isGM() && isValidSource();
      allow delete: if isGM();
    }

    // Entities: unified lore/location objects. Replaces `entries`.
    // {slug, name, category, parentId, relatedIds, visibility,
    //  hasMapImage, tags, createdAt, updatedAt}
    // 'mapId' is a dead legacy field still present on early test docs;
    // tolerated in hasOnly so updates to those docs don't fail.
    // 'subtype' (Phase 12b, SRD import): optional finer-grained label
    // under a Game Mechanics/Equipment category (e.g. subtype 'weapons'
    // under category 'Equipment'). Not category-exclusive like ancestry.
    // 'useTemplate' (structured stat-block pilot): opt-in per entity, GM-
    // set. 'details' ({key: value} strings) and 'features' ({name,text}[])
    // are the structured data it renders from -- see templates.js for the
    // per-(category,subtype) whitelist that governs which scalar fields
    // are allowed to live here vs. staying long-tail markdown.
    // 'meta' on entities is dead legacy (removed -- Meta badge is now
    // derived from category membership in CONFIG.metaCategories, not a
    // per-entity flag). Tolerated in hasOnly, same as 'mapId' above, so
    // updates to already-written docs don't fail.
    // 'dateEnd'/'dateEndSort' (time-range Scenes/Events): optional end
    // point alongside 'date'/'dateSort' -- same parse/sort-key shape,
    // null on both when the entity is a single point in time (the vast
    // majority). Only meaningful when dateSort is also set.
    // 'mapImageVisibleToPlayers': denormalized alongside hasMapImage, for
    // the same reason (map.js/codex.js need a synchronous answer without
    // loading every entity's images) -- true only when the CURRENT map
    // image (the one with isMap:true) is itself shareable to the whole
    // party (visibility:'all-players', OR 'character' with
    // characterShared:true -- Phase 14 §3.1 extension). Kept in sync at
    // every write site that can change either fact: Set map, Remove map
    // image, and toggling the map image's own visibility. Missing/false
    // is the safe default (no icon/route to players) for docs written
    // before this field existed.
    // Phase 14 (§3.1) additions: 'characterId'/'characterShared' (the
    // visibility:'character' triple, mirrored on loreItems/images too),
    // 'badgeColor' (Character entities only, owner-picked), 'cards'
    // (Character entities only -- ancestryId/communityId/classId/
    // subclassId/subclassTier/abilityIds, the character-sheet slots, S5).
    // 'metaAncestryTargetIds' (Phase 14 S7, §11.2): Ancestry entities
    // only. 0-2 target Ancestry entity ids; when set, this ancestry is
    // flavor-only -- its own name/lore display, but features/details for
    // gameplay resolve through the target(s) instead. Not enforced
    // category-exclusive here (same as 'ancestry'/'cards'/'badgeColor'
    // above) -- client-side convention, GM-authored.
    function isValidEntity() {
      return request.resource.data.keys().hasOnly(
          ['slug', 'name', 'category', 'subtype', 'parentId', 'relatedIds', 'mapId',
           'hasMapImage', 'mapImageVisibleToPlayers', 'visibility', 'characterId', 'characterShared',
           'badgeColor', 'cards', 'tags', 'createdAt', 'updatedAt',
           'ancestry', 'aliases', 'date', 'dateSort', 'dateEnd', 'dateEndSort',
           'ownerId', 'sourceId', 'meta', 'metaAncestryTargetIds',
           'useTemplate', 'details', 'features', 'searchIndex'])
        && request.resource.data.visibility in ['gm-only', 'all-players', 'character']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.slug is string
        && request.resource.data.category is string;
    }
    match /entities/{entityId} {
      allow read: if isGM() || isPlayer();

      allow create: if isGM() && isValidEntity();
      // A player may create their own Character (D4 -- full gm-control
      // over owned characters starts at creation).
      allow create: if isPlayer() && isValidEntity()
        && request.resource.data.category == 'Character'
        && request.resource.data.ownerId == request.auth.token.email;

      allow update: if isGM() && isValidEntity();
      // Full edit of an owned Character, EXCEPT ownerId/category (can't
      // reassign/recategorize your own PC out from under the rules model).
      allow update: if isPlayer() && isValidEntity() && ownsCharacter(entityId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'category']);
      // Self-release: a player may drop their own Character's ownerId to
      // null (and nothing else in the same write) -- the inverse of the
      // lock above. Characters tab (Phase 14 S8) "remove from my
      // characters" self-service, without deleting the entity or
      // requiring a GM-side action first.
      allow update: if isPlayer() && isValidEntity() && ownsCharacter(entityId)
        && request.resource.data.ownerId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'updatedAt']);
      // characterShared-only flip on an element the GM shared with the
      // player's active character (§6.2) -- never visibility/characterId
      // themselves, those stay GM-controlled via the kebab (S2).
      allow update: if isPlayer()
        && resource.data.visibility == 'character' && ownsCharacter(resource.data.characterId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['characterShared', 'updatedAt']);

      allow delete: if isGM() || (isPlayer() && ownsCharacter(entityId));
    }

    // Lore items: per-entity content blocks with individual visibility.
    // Replaces entries.content_gm/content_player.
    // {entityId, kind, authorId, authorType, visibility, content, order,
    //  createdAt, updatedAt}
    // 'meta': enum, null/absent = none, 'meta' = general GM/mechanics
    // marker, 'meta-details'/'meta-features' = structured-template pilot
    // anchor items (codex.js display-time-merges entity.details/features
    // into the first such item -- see resolveLoreItemMarkdown). Legacy
    // boolean true/false from before the enum is still tolerated (not
    // rewritten retroactively).
    // Phase 14 (§3.2): kind gains 'note' (player+GM notes; the old
    // never-actually-used 'player-note' kind is retired from the writer's
    // intent but still TOLERATED in the enum below purely as a defensive
    // read-compatibility measure in case any stray test doc used it --
    // Gregg confirmed no real data does) and 'character-lore' (Phase 14
    // S3: regular lore content -- same shape/visibility semantics as
    // 'gm-note' -- authored by a player under their own owned Character,
    // NOT the GM. Split out as its own enum value rather than reusing
    // 'gm-note' for both, since that name would be actively misleading
    // once a player can author these too; existing 'gm-note' docs are
    // untouched/unmigrated and now unambiguously mean GM-authored).
    // visibility gains 'character'.
    // characterId/characterShared mirror entities. authorType is now
    // strictly 'gm'|'character' (the old authorType:'player' path below
    // this function -- isOwnPlayerNoteWrite -- is removed wholesale; it
    // contradicted the character-authorship model and was never exercised
    // by any UI).
    function isValidLoreItem() {
      return request.resource.data.keys().hasOnly(
          ['entityId', 'kind', 'authorId', 'authorType', 'visibility', 'characterId', 'characterShared',
           'content', 'meta', 'sourceId', 'order', 'createdAt', 'updatedAt'])
        && request.resource.data.entityId is string
        && request.resource.data.kind in ['imported', 'gm-note', 'character-lore', 'note', 'player-note']
        && request.resource.data.authorType in ['gm', 'character']
        && request.resource.data.visibility in ['gm-only', 'all-players', 'character', 'author-only']
        && request.resource.data.content is string
        && (!('meta' in request.resource.data)
            || request.resource.data.meta == null
            || request.resource.data.meta is bool
            || request.resource.data.meta in ['meta', 'meta-details', 'meta-features', 'meta-narrative-backstory']);
    }
    match /loreItems/{itemId} {
      allow read: if isGM() || isPlayer();

      allow create: if isGM() && isValidLoreItem();
      // Full CRUD under an owned Character (the PC's own lore/backstory
      // items -- entityId points AT the owned Character entity itself).
      allow create: if isPlayer() && isValidLoreItem() && ownsCharacter(request.resource.data.entityId);
      // Own notes (kind:'note'; entityId can be ANY entity the note is
      // about, not necessarily the authoring character itself).
      allow create: if isPlayer() && isValidLoreItem()
        && request.resource.data.kind == 'note'
        && request.resource.data.authorType == 'character'
        && ownsCharacter(request.resource.data.authorId)
        && request.resource.data.visibility in ['author-only', 'all-players'];

      allow update: if isGM() && isValidLoreItem();
      allow update: if isPlayer() && isValidLoreItem() && ownsCharacter(resource.data.entityId);
      // content/sourceId/characterShared edit on an item the GM shared
      // with the player's active character (§6.2) -- no delete.
      allow update: if isPlayer()
        && resource.data.visibility == 'character' && ownsCharacter(resource.data.characterId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['content', 'sourceId', 'characterShared', 'updatedAt']);
      // Full edit of an own note (including its own cannon-flip -- D6's
      // binary visibility toggle is just this update path).
      allow update: if isPlayer() && isValidLoreItem()
        && resource.data.kind == 'note' && resource.data.authorType == 'character'
        && ownsCharacter(resource.data.authorId);

      allow delete: if isGM()
        || (isPlayer() && ownsCharacter(resource.data.entityId))
        || (isPlayer() && resource.data.kind == 'note' && resource.data.authorType == 'character'
              && ownsCharacter(resource.data.authorId));
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
