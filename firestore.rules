rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isGM() {
      return request.auth != null
        && request.auth.token.email == 'whitwort@gmail.com'; // keep in sync with Config.gs gmEmail
    }

    // Phase 7a: authenticated + on the players whitelist.
    function isPlayer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/players/$(request.auth.token.email));
    }

    // Phase 0 smoke-test doc only.
    match /_health/{docId} {
      allow read: if true;
      allow write: if isGM();
    }

    // Entries: content_gm vs content_player is still a client render choice
    // (not a security boundary) for content that's readable at all. But
    // Phase 7a gates the *document* itself: readable if flagged `public`,
    // or if the requester is signed-in GM/Player. Ungated (missing `public`
    // field) content is false-safe — treated as not public, i.e. gated.
    // Only GM can write.
    match /entries/{entryId} {
      allow read: if resource.data.public == true
        || (request.auth != null && (isGM() || isPlayer()));
      allow write: if isGM();
    }

    // GM's player whitelist — used to resolve authenticated-but-unlisted
    // users to Viewer vs. authenticated-and-listed users to Player.
    match /players/{email} {
      allow read: if true;
      allow write: if isGM();
    }

    // Map pins: {entryId, x, y} linking a point on the base map image to a
    // Codex entry. Same open-read/GM-write model as entries.
    match /pins/{pinId} {
      allow read: if true;
      allow write: if isGM();
    }

    // Maps: {name, image, parentMapId, public}. Root map has
    // parentMapId == null. Phase 7a: same public-flag gating as entries.
    match /maps/{mapId} {
      allow read: if resource.data.public == true
        || (request.auth != null && (isGM() || isPlayer()));
      allow write: if isGM();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
