rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isGM() {
      return request.auth != null
        && request.auth.token.email == 'whitwort@gmail.com'; // keep in sync with firestore.rules / Config.gs gmEmail
    }

    // Map base images and any other campaign assets. Everyone can view
    // (same open-read model as entries/players in firestore.rules); only
    // GM can upload/replace/delete.
    match /maps/{allPaths=**} {
      allow read: if true;
      allow write: if isGM();
    }

    // Default deny for anything not explicitly matched above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
